# ══════════════════════════════════════════════
#  Railway Monitor Bot — Sozlamalar
#  Bu faylni nusxa oling: cp .env.example .env
#  Keyin .env ni tahrirlang
# ══════════════════════════════════════════════

# @BotFather dan olingan token (MAJBURIY)
BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin huquqiga ega Telegram ID lar — MAJBURIY (bo'sh bo'lsa bot ISHGA
# TUSHMAYDI — xavfsizlik siyosati: kirish nazorati aniq bo'lmagan holatda
# bot "hamma ruxsatli" bo'lib ochiq qolmasligi kerak).
# @userinfobot ga yozing — o'z Telegram ID ingizni bilasiz.
# Admin /addUser va /addUsers orqali botga foydalanuvchi qo'sha oladi,
# /users orqali ularning faoliyatini kuzatadi, /removeUser bilan o'chiradi.
# Bir nechta: 123456789,987654321
ADMIN_IDS=123456789

# (Ixtiyoriy) ADMIN_IDS'dan tashqari, statik ravishda ruxsat berilgan
# Telegram ID lar (admin bo'lmagan, lekin doim ruxsatli foydalanuvchilar).
# Odatda kerak emas — foydalanuvchilarni /addUser orqali qo'shish tavsiya etiladi.
# Bir nechta: 123456789,987654321
ALLOWED_USERS=

# Tekshirish oralig'i soniyada (kamida 3). Haqiqiy railway.uz so'rov
# tezligi bundan alohida, RAILWAY_MIN_REQUEST_INTERVAL orqali cheklanadi.
CHECK_INTERVAL=3

# Bir vaqtda max monitoring soni
MAX_MONITORS_PER_USER=3

# Vaqt mintaqasi (Railway'da ham shu variable ni qo'ying) —
# kalendar va "sana o'tdi" tekshiruvi O'zbekiston vaqtida ishlashi uchun
TZ=Asia/Tashkent

# Ma'lumotlar papkasi (data.json shu yerga yoziladi).
# Railway'da MAJBURIY: Volume ulang (mount path /data) va DATA_DIR=/data qo'ying,
# aks holda har redeploy'da foydalanuvchilar va kuzatuvlar O'CHIB KETADI!
# Lokalda bo'sh qoldirsangiz ham bo'ladi (joriy papka ishlatiladi).
DATA_DIR=/data

# ── Railway.uz so'rov rejalashtiruvchisi (scheduler) ──────────────────────
# Bir vaqtda nechta MUSTAQIL (turli marshrut/sana) so'rov "parvozda"
# bo'lishi mumkinligi. Standart 2 — bitta sekin/retry qilayotgan marshrut
# boshqalarni butunlay to'smasin, lekin saytga ortiqcha yuklama bermasin
# deb tanlangan. 1 dan 5 gacha (xavfsizlik uchun yuqori chegara past).
RAILWAY_MAX_CONCURRENCY=2

# Haqiqiy HTTP so'rovlar orasidagi minimal oraliq (soniya), BARCHA
# marshrutlar uchun UMUMIY. Kamida 1.0 — bundan kichigi railway.uz'ga
# nisbatan xushmuomalalikka zid deb hisoblanadi va bot ishga tushmaydi.
RAILWAY_MIN_REQUEST_INTERVAL=5.0

# Bir xil marshrut+sana so'rovlarini qisqa vaqt oynasida birlashtiruvchi
# (single-flight) kesh muddati (soniya). Bot buni avtomatik ravishda
# CHECK_INTERVAL/2 dan oshmaydigan qilib cheklaydi — shuning uchun bu
# qiymatni oshirish hech qachon aniqlash kechikishini oshirmaydi, faqat
# turli monitorlarning bir vaqtdagi so'rovlarini birlashtirish samarasini
# o'zgartiradi.
SEARCH_CACHE_TTL=8.0
